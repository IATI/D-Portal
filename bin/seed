#!/usr/bin/env bash
# Copy the seed copies in dstore/json-seed and dflat/json-seed into dstore/json
# and dflat/json, but only where a file is missing. A fresh checkout can then
# build and run before the nightly fetches have run, and a file written by a
# fetch is never replaced.
cd "$(dirname "$0")/.." || exit 1

for dir in dstore/json dflat/json ; do
	for seed in "$dir-seed"/*.json ; do
		[ -e "$seed" ] || continue # no seeds, the pattern did not match
		name=$(basename "$seed")
		if [ ! -f "$dir/$name" ] ; then
			echo "Seeding $dir/$name"
			cp "$seed" "$dir/$name" || exit 1
		fi
	done
done
