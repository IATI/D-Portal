# This file is sourced, so $0 is the caller, not this file: use BASH_SOURCE.
pushd "$(dirname "${BASH_SOURCE[0]}")"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm

if nvm --version >/dev/null ; then
	true
else
	echo "installing nvm"
	curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
	export NVM_DIR="$HOME/.nvm"
	[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
fi

# Use the Node version in .nvmrc (in this directory), installing it if missing.
if nvm use ; then
	true
else
	nvm install
fi

if pm2 --version >/dev/null ; then
	true
else
	npm install -g pm2
fi

if nodemon --version >/dev/null ; then
	true
else
	npm install -g nodemon
fi

popd

